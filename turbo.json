{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": ["NEXT_PUBLIC_*", "RAILWAY_GIT_COMMIT_SHA"],
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "ENCRYPTION_KEY", "SESSION_SECRET", "BOT_TOKEN", "BOT_USERNAME"],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "ENCRYPTION_KEY"
      ]
    },
    "dev": {
      "passThroughEnv": ["*"],
      "cache": false,
      "persistent": true
    }
  }
}
