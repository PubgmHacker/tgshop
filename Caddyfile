# ─────────────────────────────────────────────────────────────────────────────
# tgshop Caddyfile — automatic HTTPS via Let's Encrypt for every subdomain.
#
# Set DOMAIN in your .env (used by docker-compose to pass it into this
# container's environment) and replace the placeholders below OR use Caddy's
# env var substitution directly, e.g. `bot.{$DOMAIN}`.
#
# Subdomain map:
#   api.{$DOMAIN}     -> bot        (Telegram webhook + Mini App API + /internal/*)
#   miniapp.{$DOMAIN}  -> miniapp    (Next.js Mini App frontend)
#   {$DOMAIN}          -> landing    (marketing landing page)
#   admin.{$DOMAIN}    -> admin      (admin panel)
# ─────────────────────────────────────────────────────────────────────────────

{
	email admin@{$DOMAIN}
}

api.{$DOMAIN} {
	reverse_proxy bot:3000
	encode gzip zstd
	log {
		output stdout
		format json
	}
}

miniapp.{$DOMAIN} {
	reverse_proxy miniapp:3100
	encode gzip zstd
	log {
		output stdout
		format json
	}
}

admin.{$DOMAIN} {
	reverse_proxy admin:3300
	encode gzip zstd
	log {
		output stdout
		format json
	}
}

{$DOMAIN}, www.{$DOMAIN} {
	reverse_proxy landing:3200
	encode gzip zstd
	log {
		output stdout
		format json
	}
}
